# Configuracion de Chess Vision Fast
# Copia este archivo a .env y configura tus valores

# Roboflow API Key (obtener en https://app.roboflow.com/settings/api)
ROBOFLOW_API_KEY=tu_api_key_aqui

# Modelo de deteccion (por defecto usa el modelo pre-entrenado de Roboflow 100)
ROBOFLOW_MODEL_ID=chess-pieces-mjzgj/1

# Backend de deteccion: 'roboflow' o 'yolo'
DETECTION_BACKEND=roboflow
